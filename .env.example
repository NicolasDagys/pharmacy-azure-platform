# Secrets required by deploy.ps1
# Do NOT use these values in production.
# Copy this file to .env and replace the placeholders with your own secrets.

# Azure SQL administrator password
# Requirements:
# - At least 12 characters
# - Uppercase letter
# - Lowercase letter
# - Number
# - Special character
# - Do not use the username or common passwords
ADMINISTRATOR_PASSWORD=<12+_characters_with_uppercase_lowercase_number_and_special_character>

# JWT signing key
# Requirements:
# - At least 32 characters
# - Use a long, random value
# - Uppercase and lowercase letters
# - Numbers
# - Special characters
JWT_KEY=<32+_character_random_secret>